{
  "name": "cortex-dl",
  "private": true,
  "version": "2.0.0",
  "description": "Cortex DL - Advanced Video and Audio Downloader",
  "repository": {
    "type": "git",
    "url": "https://github.com/SAADX25/Cortex-DL.git"
  },
  "author": "Cortex Team",
  "type": "module",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "predev": "node scripts/ensure-electron.cjs",
    "dev": "vite",
    "clean": "rimraf release",
    "build": "npm run clean && tsc && vite build && electron-builder",
    "dist": "npm run build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "node --test tests/*.test.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test --test-name-pattern=\"^(Visual Trim validates|Visual Trim suppresses|fast Pause|retry backoff|recovery never|active delete|Direct backend progress|unknown-length progress|YouTube video/audio progress|all shared media formats|yt-dlp continuation|Pause All|SQLite progress|resume broadcasts|terminal IPC|yt-dlp repeated|progress preserves|progress replaces)\" tests/coreV2.test.cjs tests/reliability.test.cjs tests/trimPreview.test.cjs",
    "test:integration": "node --test tests/coreV2.test.cjs tests/reliability.test.cjs tests/mediaLifecycle.test.cjs tests/trimPreview.test.cjs"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.4.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.7.3",
    "framer-motion": "^10.12.16",
    "lucide-react": "^0.563.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "rimraf": "^5.0.5",
    "typescript": "5.5.4",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6"
  },
  "main": "dist-electron/main.js"
}
