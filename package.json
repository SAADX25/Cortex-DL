{
  "name": "cortex-dl-development",
  "private": true,
  "description": "Development commands for the Cortex DL app",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "setup": "npm --prefix app ci",
    "dev": "npm --prefix app run dev",
    "build": "npm --prefix app run build",
    "typecheck": "npm --prefix app run typecheck",
    "lint": "npm --prefix app run lint",
    "test": "npm --prefix app test",
    "check": "npm --prefix app run check",
    "clean": "npm --prefix app run clean",
    "clean:preview": "npm --prefix app run clean -- --dry-run",
    "clean:packaged": "npm --prefix app run clean -- --packaged",
    "test:unit": "npm --prefix app run test:unit",
    "test:integration": "npm --prefix app run test:integration",
    "test:packaged": "npm --prefix app run test:packaged",
    "benchmark:startup": "npm --prefix app run benchmark:startup"
  }
}
